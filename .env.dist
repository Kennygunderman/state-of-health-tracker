# Base URL of the State of Health API, with no trailing slash — "/api" is
# appended in src/constants/endpoints.ts. Local `expo run` reads this file; EAS
# builds get the value from EAS environment variables instead.
#
# The value here is a development origin on purpose. Debug builds and Jest run a
# preflight that rejects production hosts, so a .env copied from this template
# can never point the app at production by omission.
SOH_API_BASE_URL=http://localhost:3000
